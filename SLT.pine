//@version=6

// Version
string VERSION = "V1"
indicator("SLT " + VERSION, overlay = true, max_labels_count = 300)

// By: @dmandrey
//
// These methodologies are educational references and do not guarantee any specific trading results.

//======================================================================
// CONSTANTS
//======================================================================
// Stretch Factor penalties
const int STRETCH_MODERATE_PENALTY = 10   // Stretched but not extreme
const int STRETCH_EXTREME_PENALTY = 20    // High extension risk
const int FUEL_PENALTY = 25
const int SQUEEZE_PENALTY = 30
const int LIQUIDITY_PENALTY = 25

// DASHBOARD
const string DASH_WIDTH = "                                        "
// Sized to leave headroom before the break guard for the variable-length
// gate-details loop below. History: 28 -> 30 -> 32 -> 36 as the router phases
// added optional ORB / VWAP Fade / per-module win-rate rows. The light build
// removed VWAP Fade and made ORB inert, so the live worst case is well under
// 36 (only the Trend Pull per-module row draws); the constant is kept at 36
// as slack for re-adding a module.
const int DASHBOARD_MAX_ROWS = 36

//======================================================================
// TYPES
//======================================================================
// Pine arrays cannot directly hold other arrays (no array<array<float>>),
// so a completed session's per-slot volume history is wrapped in a UDT.
type TodSession
    array<float> vols

// Per-module win-rate history (Phase 4). Pine arrays can't nest, so each
// strategy module's BUY / SELL rolling result arrays are wrapped in a UDT
// and held in a fixed 3-slot array indexed by strat_id() (0 Trend Pullback,
// 1 ORB, 2 VWAP Fade).
type ModResults
    array<bool> buys
    array<bool> sells

//======================================================================
// INPUTS  —  SLT-light: three user controls
//   1. Signal Anchor  (EMA Cross / SMA)
//   2. Score Stars    (label selectivity)
//   3. P&L Exit        (on/off + target %)
// Everything else is auto-tuned from the asset profile (see the profile
// block below) and the anchor choice. To hand-tune, edit the profile
// table — not the settings panel.
//======================================================================

grp_anchor = "📍 Signal Anchor"
anchorMode = input.string("SMA", "Signal Anchor",
     options = ["EMA Cross", "SMA"],
     group = grp_anchor,
     tooltip = "EMA CROSS:\n" +
               "• Signals on EMA9 crossing the slow EMA\n" +
               "• Faster, earlier entries — more signals\n" +
               "• Best for: NVDA, TSLA (fast movers), aggressive trading\n\n" +
               "SMA:\n" +
               "• Signals on price crossing a slow structural SMA\n" +
               "• Slowest anchor — ATR buffer band + latched state kills whipsaw\n" +
               "• Best for: choppy instruments, fewer / higher-conviction entries\n\n" +
               "Slow-EMA period, SMA length, SMA buffer, min score, RTH filter and\n" +
               "entry-freshness are all set automatically from the asset profile\n" +
               "and this choice. Both anchors share the same scoring / gates.")

grp_sig = "Signal"
sigQuality = input.string("⭐ +", "Score Stars",
     options = ["All Signals", "⭐ +", "⭐⭐ +", "⭐⭐⭐ Only"],
     group = grp_sig,
     tooltip = "How selective the BUY/SELL labels are, on top of the auto min score:\n" +
               "• All Signals: show everything (including ⚠️ WEAK)\n" +
               "• ⭐ +: GOOD, STRONG, EXCELLENT\n" +
               "• ⭐⭐ +: STRONG, EXCELLENT\n" +
               "• ⭐⭐⭐ Only: top-tier setups only")

grp_pnl = "💰 P&L Exit Signals"
enablePnL = input.bool(true, "Enable P&L Exit Signals", group = grp_pnl,
     tooltip = "Show PROFIT/LOSS exit markers when price moves ±target % from entry.")
pnlTarget = input.float(1.0, "P&L Target (%)", minval = 0.1, maxval = 10.0, step = 0.1, group = grp_pnl,
     tooltip = "PROFIT/LOSS fires at ±this percent from entry. Default 1.0%.")

grp_vis = "📊 Dashboard & Visuals"
showDash = input.bool(true, "Show Dashboard", group = grp_vis,
     tooltip = "Bottom-right metrics table.")
extDash  = input.bool(false, "Extended Metrics", group = grp_vis,
     tooltip = "Adds the per-component point breakdown, win-rate rows and diagnostic rows to the dashboard.")

//======================================================================
// FIXED BEHAVIOUR
// User-configurable in the parent script; pinned here to the tuned
// defaults so the light build stays a minimal-control surface.
//======================================================================
bool   showLabels        = true
string sigTime           = "Score"        // fire only when score clears the auto minimum
bool   gateOn            = true            // risk gates always enforced
string rvolMode          = "Time-of-Day"  // auto-falls back to 20-bar on thin history
int    rvolLookbackDays  = 10
bool   enableSuccessRate = true
int    maxSignalsToTrack = 50
bool   showSignalPnL     = true
bool   showCircles       = true            // trend-flip circles always on
bool   showBg            = true            // trend background always on

// ORB strategy module — retired in the light build. Kept inert
// (orbEnabled = false) so the router / dashboard / plot code that still
// references these names compiles; none of that path is reachable.
bool  orbEnabled         = false
int   orbMinutes         = 30
int   orbEntryCutoffMin  = 120
float orbBufferATR       = 0.05
float orbMinRvol         = 1.2
bool  orbRequireVwapSide = true
int   orbMinQuality      = 45
bool  orbShowLevels      = false


//======================================================================
// ASSET DETECTION & PROFILE ASSIGNMENT
//======================================================================
// 1. Core Detection using syminfo.type
string asset_category = switch syminfo.type
    "stock"   => "STOCK"
    "fund"    => "FUND"
    "futures" => "FUTURES"
    "crypto"  => "CRYPTO"
    =>           "MARKET" // Fallback for Index, Forex, or Unknown

// 2. FIX #3: Initialize Threshold Variables WITHOUT 'var'
// These are simple variables that get assigned once based on profile
float vwap_h_limit = 1.5   // VWAP Healthy Limit (default)
float vwap_e_limit = 3.0   // VWAP Extended Limit (default)
float adx_min      = 22.0  // ADX Trending Floor (default)
float rvol_gate    = 0.8   // RVOL Minimum (default)
float ext_scale    = 2.5   // Overextension ATR Multiplier (default)
float fuel_max     = 85.0  // ATR Fuel Limit (default)
int   ema_max      = 20    // EMA Cascade max points (default)
int   vwap_max     = 25    // VWAP Value max points (default)
int   sma_len      = 70    // SMA anchor length (default)
// SLT-light auto-tune fields (resolved to effective params after this chain)
int   ema_slow_auto  = 30    // EMA Cross slow leg
float sma_buf_auto   = 0.25  // SMA latch band (x ATR-14)
int   min_score_auto = 50    // auto min score, both directions
bool  rth_auto       = true  // RTH session filter (off for 24h profiles)
string profile_name = "DEFAULT"

// 3. Profile Assignment Logic
if asset_category == "MARKET"
    profile_name := "MARKET INDEX 🏦"
    vwap_h_limit := 0.7
    vwap_e_limit := 1.5
    adx_min := 25.0
    rvol_gate := 1.0
    ext_scale := 2.0
    fuel_max := 80.0
    ema_max := 22    // EMA Cascade max points (default)
    vwap_max := 23    // VWAP Value max points (default)
    sma_len := 90     // Slower anchor — indices grind, few clean crosses
    ema_slow_auto := 30
    sma_buf_auto := 0.20
    min_score_auto := 55
    rth_auto := true

else if asset_category == "FUND"
    profile_name := "ETF / FUND 📊"
    vwap_h_limit := 1.0
    vwap_e_limit := 2.0
    adx_min := 18.0
    rvol_gate := 1.0
    ext_scale := 2.2
    fuel_max := 75.0
    ema_max := 20    // EMA Cascade max points (default)
    vwap_max := 25    // VWAP Value max points (default)
    sma_len := 90     // Smooth trends — longer average holds structure
    ema_slow_auto := 30
    sma_buf_auto := 0.20
    min_score_auto := 50
    rth_auto := true

else if asset_category == "STOCK"
    profile_name := "STOCK 🚀"
    vwap_h_limit := 1.8
    vwap_e_limit := 3.5
    adx_min := 20.0
    rvol_gate := 1.2
    ext_scale := 3.0
    fuel_max := 85.0
    ema_max := 20    // EMA Cascade max points (default)
    vwap_max := 25    // VWAP Value max points (default)
    sma_len := 70     // Source-script baseline — ~2.3h on a 2-min chart
    ema_slow_auto := 20
    sma_buf_auto := 0.25
    min_score_auto := 50
    rth_auto := true

else if asset_category == "FUTURES"
    profile_name := "FUTURES ⚡"
    vwap_h_limit := 1.5
    vwap_e_limit := 3.0
    adx_min := 15.0
    rvol_gate := 0.6
    ext_scale := 2.5
    fuel_max := 90.0
    ema_max := 30    // EMA Cascade max points (default)
    vwap_max := 15    // VWAP Value max points (default)
    sma_len := 70     // Matches the CL/crude source script this was drawn from
    ema_slow_auto := 30
    sma_buf_auto := 0.30
    min_score_auto := 45
    rth_auto := false   // 24h contract — RTH filter would blackout most of the day

else if asset_category == "CRYPTO"
    profile_name := "CRYPTO 🪙"
    vwap_h_limit := 3.0
    vwap_e_limit := 6.0
    adx_min := 28.0
    rvol_gate := 0.6
    ext_scale := 4.0
    fuel_max := 95.0
    ema_max := 25    // EMA Cascade max points (default)
    vwap_max := 20    // VWAP Value max points (default)
    sma_len := 120    // 24h trading — needs a much longer window per "session"
    ema_slow_auto := 20
    sma_buf_auto := 0.35
    min_score_auto := 55
    rth_auto := false   // 24h market — RTH filter would blackout most of the day

else
    profile_name := "STANDARD STOCK 📈" // Defaults already set above

//======================================================================
// AUTO-TUNE RESOLUTION  (asset profile + anchor -> effective parameters)
// These names are what the rest of the script reads; in the parent
// project they were user inputs.
//======================================================================
int   emaSlowPeriod    = ema_slow_auto                     // EMA Cross slow leg (20 / 30 by profile)
float smaBufferATR     = sma_buf_auto                      // SMA latch band, x ATR-14
int   minScoreBuy      = min_score_auto                    // auto min score, both directions
int   minScoreSell     = min_score_auto
bool  useSessionFilter = rth_auto                          // RTH filter — off for 24h profiles (FUTURES / CRYPTO)
// Entry-freshness cap (Score mode only): EMA9/slow crosses lag the turn, so
// cap how far past a flip an entry may fire; the SMA anchor is latched and
// already fires on the flip bar, so it needs no cap.
int   maxBarsFromFlip  = anchorMode == "SMA" ? 0 : 10

//======================================================================
// CORE INDICATOR CALCULATIONS
//======================================================================

// EMAs (9 + profile slow period for EMA Cross, 50 for cascade scoring)
ema9  = ta.ema(close, 9)
emaSlow = ta.ema(close, emaSlowPeriod)
ema50 = ta.ema(close, 50)

// Keep ema20 reference for Component 1 scoring (always uses 20)
ema20 = ta.ema(close, 20)

// SMA anchor — only drives signals when anchorMode == "SMA", but computed on
// every bar like every other series here. Length is the per-profile sma_len.
int smaLenActive = sma_len
smaAnchor = ta.sma(close, smaLenActive)

// VWAP (Session-based - Component 2)
vwap = ta.vwap(close)

// Volatility & Momentum
atr = ta.atr(14)
rsiVal = ta.rsi(close, 14)
[_, _, adx] = ta.dmi(14, 14)


// Consolidated ADX trend detection (used by multiple components)
bool adx_rising_3 = ta.rising(adx, 3)  // 3-bar: Velocity Override
bool adx_rising_2 = ta.rising(adx, 2)  // 2-bar: Setup Score ADX component


// Relative Volume: computed after session-tracking (Time-of-Day RVOL
// needs is_new_session, which is defined further below) — see rel_vol
// assignment near the ATR Fuel Gauge section.

//======================================================================
// TREND EXTENSION TRACKING
//======================================================================
var float trend_start_price = na  // Price at anchor flip

//======================================================================
// MARKET REGIME DETECTION
//======================================================================

// 1. SQUEEZE STATE (Bollinger Bands vs Keltner Channels)
[bbU, bbB, bbL] = ta.bb(close, 20, 2.0)
kc_mult = 1.5
kcU = bbB + (ta.atr(20) * kc_mult)
kcL = bbB - (ta.atr(20) * kc_mult)

bool is_squeezing = bbU <= kcU and bbL >= kcL
bool sqz_release  = not is_squeezing and is_squeezing[1]

// 2. STRETCH FACTOR — unified measurement of mean-reversion risk (EMA)
// and trend exhaustion (flip price)
float ema_stretch = math.abs(close - ema20) / atr  // Distance from EMA20 in ATR units
// Note: trend_stretch calculated after trend_start_price is tracked (see Gate section)

// VELOCITY OVERRIDE
// Detects high-conviction momentum that justifies exceeding standard ATR range
bool is_high_velocity = adx > 35 and adx_rising_3

//======================================================================
// 3. ATR VOLATILITY FUEL GAUGE (Multi-Asset Session-Aware)
//======================================================================

// Track session high/low (adapts to instrument type)
var float session_high = na
var float session_low = na

// Detect new session start. Every instrument type uses the same daily-bar
// boundary — TradingView's "D" bars already align to each instrument's own
// session start (midnight for stocks/ETFs/indices and crypto, ~6 PM ET for
// futures), so no per-type branching is needed here. (This previously existed
// as four if/else branches with identical bodies.)
bool is_new_session = ta.change(time("D")) != 0 or na(session_high[1])

// Reset or update session range
if is_new_session
    session_high := high
    session_low := low
else
    session_high := math.max(session_high, high)
    session_low := math.min(session_low, low)

// Calculate session range (handles all session types)
float session_range = not na(session_high) and not na(session_low) ? 
                      session_high - session_low : 0.0

// ATR Fuel: Compare intraday session range vs average daily range (14-period)
// Uses Daily timeframe ATR with lookahead=off uses previous day's ATR, no repainting
// This measures "% of typical daily range consumed so far today"
float atr_14 = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead=barmerge.lookahead_off)


// Volatility fuel used as percentage of intraday ATR
float fuel_used = atr_14 > 0 ? (session_range / atr_14) * 100 : 0

// Safety cap: Prevent extreme values due to session boundary issues
// Max realistic value: 200% (extreme volatility day = 2x normal ATR)
fuel_used := math.min(fuel_used, 200.0)

// Exhaustion threshold (profile-specific via fuel_max)
bool fuel_exhausted = fuel_used > fuel_max

//======================================================================
// TIME-OF-DAY RELATIVE VOLUME
//======================================================================
// tod_vol_history: one TodSession per completed session, indexed by
// bar-slot-since-session-open (slot 0 = first bar of the session).
// FIFO-capped at rvolLookbackDays completed sessions.
var array<TodSession> tod_vol_history = array.new<TodSession>()
var TodSession tod_current_session = TodSession.new(array.new<float>())
var int tod_slot_idx = 0

if is_new_session
    // Finalize the just-completed session into history (skip empty first run)
    if array.size(tod_current_session.vols) > 0
        array.push(tod_vol_history, tod_current_session)
        if array.size(tod_vol_history) > rvolLookbackDays
            array.shift(tod_vol_history)
    tod_current_session := TodSession.new(array.new<float>())
    tod_slot_idx := 0

array.push(tod_current_session.vols, volume)

// Average volume at this same bar-slot across prior sessions
float tod_vol_sum = 0.0
int tod_vol_count = 0
int tod_hist_sessions = array.size(tod_vol_history)
if tod_hist_sessions > 0
    for s = 0 to tod_hist_sessions - 1
        TodSession tod_sess = array.get(tod_vol_history, s)
        if tod_slot_idx < array.size(tod_sess.vols)
            tod_vol_sum += array.get(tod_sess.vols, tod_slot_idx)
            tod_vol_count += 1

// Require at least 3 historical sessions at this slot for a meaningful average
bool tod_data_sufficient = tod_vol_count >= 3
float tod_vol_avg = tod_data_sufficient ? tod_vol_sum / tod_vol_count : na

tod_slot_idx += 1

// Relative Volume: Rolling 20-bar (always computed, used as fallback) +
// Time-of-Day (used when selected and sufficient history exists)
vol_ma20 = ta.sma(volume, 20)
// The `: 1.0` fallback is what makes volume-less feeds (index symbols such as
// TVC:NDQ or TSX:TSX, where volume is na/0) behave sanely: rel_vol becomes a
// neutral 1.0 instead of na. Two consequences depend on that exact value —
//   1. Component 3 awards its `>= 1.0` tier (5 pts) rather than 0.
//   2. Gate 4 stays quiet, because `volume_is_dead` tests `rel_vol < rvol_gate`
//      and MARKET's rvol_gate is also exactly 1.0.
// That second one is a knife-edge tie, not a design: raising MARKET's rvol_gate
// above 1.0 would silently pin a permanent -25 liquidity penalty on every
// volume-less index. If you tune that value, add an explicit volume-availability
// check here instead of relying on this fallback.
float rel_vol_rolling = vol_ma20 > 0 ? volume / vol_ma20 : 1.0
float rel_vol_tod = tod_data_sufficient and not na(tod_vol_avg) and tod_vol_avg > 0 ? volume / tod_vol_avg : na

bool tod_rvol_active = rvolMode == "Time-of-Day" and not na(rel_vol_tod)
rel_vol = tod_rvol_active ? rel_vol_tod : rel_vol_rolling
string rvol_mode_label = tod_rvol_active ? "TOD" : (rvolMode == "Time-of-Day" ? "20-bar*" : "20-bar")


//======================================================================
// DUAL-ANCHOR TREND CLASSIFICATION
//======================================================================

// ANCHOR 1: EMA Cross (uses user-selected slow period)
bool ema_is_bull = ema9 > emaSlow
bool ema_is_bear = ema9 < emaSlow
bool ema_flip_up = ta.crossover(ema9, emaSlow) and barstate.isconfirmed
bool ema_flip_down = ta.crossunder(ema9, emaSlow) and barstate.isconfirmed

// ANCHOR 2: SMA with ATR buffer band + latched state.
//
// A raw price/SMA cross whipsaws hard on a 2-min chart — price crosses a slow
// average many times per session in chop, and in Trend mode trendUp fires the
// signal directly off the flip. The buffer band (smaBufferATR x ATR-14) creates
// a neutral zone that price must fully clear before the state changes.
//
// The state is LATCHED (var bool) rather than left neutral inside the band,
// which matters downstream: several consumers are written as `is_bull ? .. : ..`
// with no third case (dashboard trend row, SMA line color), so a bar where both
// is_bull and is_bear were false would silently render as bearish. Latching
// keeps the is_bull/is_bear contract strictly binary, exactly like the other
// two anchors.
//
// Only updated on confirmed bars, so the state cannot flip intrabar and then
// revert — same non-repainting guarantee the other two anchors carry.
float sma_band = smaBufferATR * atr
var bool sma_state_bull = true

// Previous bar's latched state, captured BEFORE this bar's update below.
// sma_state_bull is `var`, so at this point it still holds the value it ended
// the previous bar with. This is deliberately not `sma_state_bull[1]`: that
// reads na on bar 0, which would make the flip booleans na rather than false,
// and nz() has no bool overload to default it with (CE10123).
var bool sma_prev_bull = true
sma_prev_bull := sma_state_bull

if barstate.isconfirmed and not na(smaAnchor) and not na(sma_band)
    if close > smaAnchor + sma_band
        sma_state_bull := true
    else if close < smaAnchor - sma_band
        sma_state_bull := false
    // inside the band: hold the previous state (hysteresis)

bool sma_is_bull = sma_state_bull
bool sma_is_bear = not sma_state_bull
bool sma_flip_up = sma_state_bull and not sma_prev_bull and barstate.isconfirmed
bool sma_flip_down = not sma_state_bull and sma_prev_bull and barstate.isconfirmed

// Select active anchor based on user input.
// NOTE: these chains END in the EMA Cross branch, so any anchorMode value other
// than "SMA" resolves to EMA Cross behavior — it does not error.
bool is_bull = anchorMode == "SMA" ? sma_is_bull : ema_is_bull
bool is_bear = anchorMode == "SMA" ? sma_is_bear : ema_is_bear
bool trendUp = anchorMode == "SMA" ? sma_flip_up : ema_flip_up
bool trendDown = anchorMode == "SMA" ? sma_flip_down : ema_flip_down

// Price of whichever anchor line is currently plotted. Single source of truth
// for BUY/SELL label anchoring and the dashboard Trend row.
float anchor_line_price = anchorMode == "SMA" ? smaAnchor : ema9

// Short label for the active anchor, used in the dashboard Trend row.
string anchor_short = anchorMode == "SMA" ? "SMA" : "EMA9"

// Is the active anchor warmed up enough to be trusted?
//
// Both EMAs produce usable values from the first bars, but
// ta.sma returns na until smaLenActive bars exist (70-120 depending on
// profile). sma_state_bull is initialized true and its update block is skipped
// while smaAnchor is na, so WITHOUT this guard the SMA anchor reports
// is_bull = true for that entire warm-up window regardless of actual price
// direction. In the default configuration (Score timing, maxBarsFromFlip = 0)
// that is enough on its own to fire a BUY on score alone — in a downtrend —
// seeding the win-rate array with an entry the anchor never endorsed and
// drawing its label at a na price.
bool anchor_ready = anchorMode == "SMA" ? not na(smaAnchor) : true

// Track anchor flip as reference point for Trend Extension tracking
if (trendUp or trendDown)
    trend_start_price := close

// Bars since the most recent anchor flip — 0 on the flip bar itself,
// incrementing every bar after. Drives the Score-mode entry freshness gate
// (maxBarsFromFlip) and the "Bars From Flip" Extended Metrics display.
var int bars_since_flip = 0
if trendUp or trendDown
    bars_since_flip := 0
else
    bars_since_flip += 1


//======================================================================
// SCORING ENGINE - 100 POINT SYSTEM
//======================================================================

// COMPONENT 1: EMA CASCADE ALIGNMENT (profile-adaptive: 20-25 points)
int t_pts = 0
string t_status = ""

bool bull_cascade = ema9 > ema20 and ema20 > ema50
bool bear_cascade = ema9 < ema20 and ema20 < ema50

// Proportional scoring: 100% / 60% / 30% / 0% of ema_max
int ema_full    = ema_max
int ema_partial = math.round(ema_max * 0.60)
int ema_weak    = math.round(ema_max * 0.30)

// Direction is the selected anchor (is_bull/is_bear): Component 1 measures
// how well the EMA cascade *confirms the anchor's direction* — a directional
// confluence term added to raw_score, which is then tested against a
// direction-specific threshold. (A brief experiment keying this off ema9 vs
// ema20 instead made the term non-directional and was reverted: it suppressed
// with-trend pullback entries and added cascade points to counter-trend
// signals. SMA-mode raw_score skews slightly higher on continuation as a
// result — accepted; see CLAUDE.md "SMA Anchor".)
if is_bull
    if bull_cascade and close > ema9
        t_pts := ema_full
        t_status := "✅ FULL CASCADE"
    else if close > ema20
        t_pts := ema_partial
        t_status := "⚠️ PARTIAL"
    else if close > ema50
        t_pts := ema_weak
        t_status := "⚠️ WEAK"
    else
        t_pts := 0
        t_status := "🔴 COUNTER-TREND"
else if is_bear
    if bear_cascade and close < ema9
        t_pts := ema_full
        t_status := "✅ FULL CASCADE"
    else if close < ema20
        t_pts := ema_partial
        t_status := "⚠️ PARTIAL"
    else if close < ema50
        t_pts := ema_weak
        t_status := "⚠️ WEAK"
    else
        t_pts := 0
        t_status := "🔴 COUNTER-TREND"

// COMPONENT 2: VWAP VALUE ANCHOR (profile-adaptive: 20-25 points)
int v_pts = 0
string v_status = ""

// Proportional scoring: 100% / 72% / 40% / 20% / 0% of vwap_max
int vwap_full    = vwap_max
int vwap_healthy = math.round(vwap_max * 0.72)
int vwap_extended = math.round(vwap_max * 0.40)
int vwap_grace   = math.round(vwap_max * 0.20)

// Calculate distance from VWAP as percentage (with safety check)
float vwap_dist_pct = 0.0

// Safety check: Ensure VWAP is valid before calculating
if not na(vwap) and vwap > 0 and not na(close) and close > 0
    vwap_dist_pct := math.abs((close - vwap) / vwap) * 100
    
    if is_bull
        // Bullish: Want price ABOVE VWAP
        if close > vwap and vwap_dist_pct <= (vwap_h_limit * 0.33)
            v_pts := vwap_full
            v_status := "✅ BOUNCE (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else if close > vwap and vwap_dist_pct <= vwap_h_limit
            v_pts := vwap_healthy
            v_status := "✅ HEALTHY (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else if close > vwap and vwap_dist_pct <= vwap_e_limit
            v_pts := vwap_extended
            v_status := "⚠️ EXTENDED (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else if close > vwap
            v_pts := 0
            v_status := "🔴 REVERSION RISK (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        // Grace zone: bull gets 20% of h_limit tolerance (tighter for short side below)
        else if close < vwap and vwap_dist_pct <= (vwap_h_limit * 0.2)
            v_pts := vwap_grace
            v_status := "⚠️ GRACE ZONE (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else
            v_pts := 0
            v_status := "🔴 WRONG SIDE (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
            
    else if is_bear
        // Bearish: Want price BELOW VWAP
        if close < vwap and vwap_dist_pct <= (vwap_h_limit * 0.33)
            v_pts := vwap_full
            v_status := "✅ REJECTION (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else if close < vwap and vwap_dist_pct <= vwap_h_limit
            v_pts := vwap_healthy
            v_status := "✅ HEALTHY (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else if close < vwap and vwap_dist_pct <= vwap_e_limit
            v_pts := vwap_extended
            v_status := "⚠️ EXTENDED (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else if close < vwap
            v_pts := 0
            v_status := "🔴 REVERSION RISK (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        // Grace zone: bear gets 10% of h_limit tolerance (stricter than bull's 20%)
        else if close > vwap and vwap_dist_pct <= (vwap_h_limit * 0.1)
            v_pts := vwap_grace
            v_status := "⚠️ GRACE ZONE (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
        else
            v_pts := 0
            v_status := "🔴 WRONG SIDE (" + str.tostring(vwap_dist_pct, "#.##") + "%)"
else
    // VWAP is invalid (na or zero) - handle gracefully
    v_pts := 0
    v_status := "⚠️ NO VWAP DATA"

// COMPONENT 3: VOLUME INTENSITY (25 points) - PROFILE-ADAPTIVE
int vol_pts = 0
string vol_status = ""
float rvol_threshold = rvol_gate // Profile-specific minimum

if rel_vol >= 2.5
    vol_pts := 25
    vol_status := "💥 EXPLOSIVE"
else if rel_vol >= 2.0
    vol_pts := 20
    vol_status := "🔥 HUGE SPIKE"
else if rel_vol >= 1.5
    vol_pts := 15
    vol_status := "🔥 BIG SPIKE"
else if rel_vol >= 1.2
    vol_pts := 10
    vol_status := "📈 ELEVATED"
else if rel_vol >= 1.0
    vol_pts := 5
    vol_status := "➡️ NORMAL"
else
    vol_pts := 0
    vol_status := "🔴 DEAD"

// LIQUIDITY GATE: If volume below threshold, force score cap
bool volume_is_dead = rel_vol < rvol_threshold

vol_status += " (" + str.tostring(rel_vol, "#.#") + "x " + rvol_mode_label + ")"

// COMPONENT 4: ADX TREND STRENGTH (15 points) - PROFILE-ADAPTIVE
bool adx_rising = adx_rising_2  // 2-bar check for stability
int a_pts = 0
string a_status = ""
bool is_choppy = adx < (adx_min * 0.9) // Scales choppy filter

// ADX thresholds scale proportionally with profile-specific adx_min
// Multipliers: 1.6x (VERY STRONG), 1.3x (STRONG), 1.0x (TRENDING),
//              0.8x (MODERATE), 0.6x (WEAK), <0.6x (CHOPPY)
// Example: MARKET profile (adx_min=25) → VERY STRONG = 40

if adx >= (adx_min * 1.6) // Scaled VERY STRONG (approx 35 for standard)
    if adx_rising
        a_pts := 15
        a_status := "🔥 RISING STRONG"
    else
        a_pts := 12
        a_status := "💪 VERY STRONG"
else if adx >= (adx_min * 1.3) // Scaled STRONG (approx 28 for standard)
    if adx_rising
        a_pts := 12
        a_status := "🔥 RISING "
    else
        a_pts := 9
        a_status := "💪 STRONG"
else if adx >= adx_min
    a_pts := 9
    a_status := "📈 TRENDING"
else if adx >= (adx_min * 0.8)
    a_pts := 6
    a_status := "➡️ MODERATE"
else if adx >= (adx_min * 0.6)
    a_pts := 3
    a_status := "⚠️ WEAK"
else
    a_pts := 0
    a_status := "🔴 CHOPPY"

a_status += " (ADX: " + str.tostring(adx, "#.#") + ")"

// COMPONENT 5: MOMENTUM CONFLUENCE (20 points) - RSI + SQUEEZE
// MACD sub-component removed: MACD-line sign is ~EMA12>EMA26, a near-duplicate
// of Component 1's EMA cascade, so it added almost no independent signal. Its
// 8 points were redistributed proportionally (7:5) across the two remaining
// sub-components — RSI 7->12, Squeeze 5->8 — keeping Component 5 at max 20.

// Sub-component A: RSI REGIME-AWARE MOMENTUM (12 points)
int rsi_pts = 0
bool rsi_rising = ta.rising(rsiVal, 2)
bool rsi_breakout = rsiVal > 60 and rsi_rising

if is_bull
    if rsi_breakout // High-conviction momentum
        rsi_pts := 12
    else if rsiVal > 45 and rsiVal <= 60
        rsi_pts := 8
    else if rsiVal > 60 and not rsi_rising // Stalling at highs (contiguous with the >60/<=60 tiers above)
        rsi_pts := 3
    else
        rsi_pts := 0
else if is_bear
    if rsiVal < 45 and not rsi_rising // High-conviction downside
        rsi_pts := 12
    else if rsiVal < 55 and rsiVal >= 40
        rsi_pts := 8
    else if rsiVal < 40 and rsi_rising // Stalling at lows (contiguous with the >=40/<40 tiers above)
        rsi_pts := 3
    else
        rsi_pts := 0

// Sub-component B: SQUEEZE RELEASE MOMENTUM (8 points)
// Moved from Gate 5 to always-active scoring
// Rewards expansion opportunities regardless of Gate ON/OFF setting
int sqz_pts = 0
string sqz_status = ""

if sqz_release and rel_vol > 1.5
    sqz_pts := 8
    sqz_status := "💥 BREAKOUT"
else if sqz_release
    sqz_pts := 3
    sqz_status := "⚠️ WEAK BO"
else
    sqz_pts := 0
    sqz_status := "—"

// Combined Momentum Score (max 20 points)
int r_pts = rsi_pts + sqz_pts
string r_status = ""

if r_pts >= 16
    r_status := "✅ FULL"
else if r_pts >= 12
    r_status := "✅ STRONG"
else if r_pts >= 8
    r_status := "⚠️ PARTIAL"
else if r_pts >= 3
    r_status := "⚠️ WEAK"
else
    r_status := "🔴 DIVERGING"

r_status += " (RSI: " + str.tostring(rsiVal, "#.#") + " | SQZ: " + sqz_status + ")"


// CALCULATE RAW SCORE (5 components, max 105 points → capped at 100)
// Component maxes: EMA(20) + VWAP(25) + Volume(25) + ADX(15) + Momentum(20) = 105
int raw_score = t_pts + v_pts + vol_pts + a_pts + r_pts
raw_score := math.min(raw_score, 100)


//======================================================================
// RISK GATES - CALCULATE ALL 4 GATES
//======================================================================
// Gates 1-4: Applied to final_score (affects signal generation)
// In ADVISORY MODE: All gates shown but not applied
// In ENFORCEMENT MODE: All gates applied to final_score
// NOTE: The old Gate 5 (Breakout Bonus) lives in Component 5C instead
//======================================================================

//----------------------------------------------------------------------
// Gate 1: Squeeze (Low Volatility / Range Bound)
//----------------------------------------------------------------------
bool gate1_squeeze = is_squeezing

//----------------------------------------------------------------------
// Gate 2: STRETCH FACTOR
// Combines EMA mean-reversion risk + trend exhaustion into single metric
//----------------------------------------------------------------------
// Calculate trend stretch (move since flip)
float trend_move = not na(trend_start_price) ? 
                   math.abs(close - trend_start_price) : 0.0
// Use intraday ATR for both components so the scales are comparable
float trend_stretch = atr > 0 ? trend_move / atr : 0.0

// Unified Stretch Factor = MAX(EMA stretch, Trend stretch)
// Both normalized by intraday ATR(14) — comparable units
float stretch_factor = math.max(ema_stretch, trend_stretch)

// Tiered stretch assessment (profile-adaptive via ext_scale)
string stretch_status = ""
int stretch_penalty = 0

if stretch_factor > (ext_scale * 1.5)
    stretch_penalty := STRETCH_EXTREME_PENALTY
    stretch_status := "🎯 EXTREME"
else if stretch_factor > ext_scale
    stretch_penalty := STRETCH_MODERATE_PENALTY
    stretch_status := "⚠️ STRETCHED"
else
    stretch_penalty := 0
    stretch_status := "✅ HEALTHY"

// Velocity override — a genuine high-conviction momentum regime (ADX > 35
// rising 3 bars, `is_high_velocity`) is allowed to run past the standard
// extension band, exactly as it already bypasses Gate 3 (ATR Fuel). The raw
// stretch tier is still computed and shown as advisory in the gate message;
// only the score penalty is waived.
bool gate2_raw        = stretch_penalty > 0
bool gate2_overridden = gate2_raw and is_high_velocity
bool gate2_stretched  = gate2_raw and not is_high_velocity

//----------------------------------------------------------------------
// Gate 3: ATR Fuel Exhaustion (Session Range Maxed)
//----------------------------------------------------------------------
bool gate3_fuel = fuel_exhausted and not is_high_velocity

//----------------------------------------------------------------------
// Gate 4: Liquidity & Strength Circuit Breaker
//----------------------------------------------------------------------
bool gate4_liquidity = volume_is_dead and is_choppy

//----------------------------------------------------------------------
// Calculate penalty values (for display and application)
//----------------------------------------------------------------------
int gate1_penalty = gate1_squeeze ? SQUEEZE_PENALTY : 0
int gate2_penalty = gate2_stretched ? stretch_penalty : 0  // Tiered stretch penalty (waived under velocity override)
int gate3_penalty = gate3_fuel ? FUEL_PENALTY : 0
int gate4_penalty = gate4_liquidity ? LIQUIDITY_PENALTY : 0

// Build gate message (always visible regardless of gateOn setting)
string gate_message = ""

if gate1_squeeze
    gate_message += "🚧 SQUEEZE (-" + str.tostring(gate1_penalty) + ") "

if gate2_raw
    string stretch_detail = str.tostring(stretch_factor, "#.#") + " ATR"
    if gate2_overridden
        gate_message += stretch_status + " (🔥 VELOCITY | " + stretch_detail + ") "
    else
        gate_message += stretch_status + " (-" + str.tostring(gate2_penalty) + " | " + stretch_detail + ") "

if gate3_fuel
    gate_message += "🛑 ATRFUEL (-" + str.tostring(gate3_penalty) + ") "

if gate4_liquidity
    gate_message += "🚫 LIQUIDITY (-" + str.tostring(gate4_penalty) + ") "


//======================================================================
// RISK GATES - APPLY GATES 1-4 TO FINAL SCORE (ENFORCEMENT MODE ONLY)
//======================================================================
// Gates 1-4 (pure risk filters)
//======================================================================
int final_score = raw_score

if gateOn
    // ENFORCEMENT MODE: Apply all penalties

    // Gate 1: Squeeze (Low Volatility / Range Bound)
    if gate1_squeeze
        final_score := math.max(final_score - gate1_penalty, 0)

    // Gate 2: Stretch Factor (Unified - Mean Reversion + Trend Exhaustion)
    // gate2_stretched already excludes the is_high_velocity override.
    if gate2_stretched
        final_score := math.max(final_score - gate2_penalty, 0)

    // Gate 3: Volatility Fuel Exhaustion (Session Range Maxed)
    if gate3_fuel
        final_score := math.max(final_score - FUEL_PENALTY, 0)

    // Gate 4: Liquidity & Strength Circuit Breaker
    if gate4_liquidity
        final_score := math.max(final_score - gate4_penalty, 0)

// Final Safety Clamp
final_score := math.max(math.min(final_score, 100), 0)

// Setup quality rating (stars) is derived from the ACTIVE strategy's
// quality, so it is computed after the regime router — see the "Setup
// quality rating" block below the STRATEGY MODULES section.

//======================================================================
// SIGNAL QUALITY FILTER
//======================================================================
passes_quality_filter(int score, int min_threshold) =>
    bool result = false
    
    if sigQuality == "All Signals"
        result := score >= 0
    else if sigQuality == "⭐ +"
        result := score >= min_threshold
    else if sigQuality == "⭐⭐ +"
        result := score >= (min_threshold + 15)
    else if sigQuality == "⭐⭐⭐ Only"
        result := score >= (min_threshold + 30)
    
    result

//======================================================================
// SIGNAL P&L HISTORY TRACKING (INDEPENDENT FROM LIVE P&L)
//======================================================================
var float last_signal_price = na
var string last_signal_type = "NONE"
var bool has_previous_signal = false

//======================================================================
// RTH SESSION WINDOW
//======================================================================
// Defined here (ahead of P&L exit tracking) because the session-open reset
// must clear stale position state BEFORE current_pnl / PROFIT / LOSS are
// evaluated on the session-open bar itself.
bool in_session       = not useSessionFilter or not na(time(timeframe.period, "0930-1600:23456"))
bool prev_in_session   = not na(time(timeframe.period, "0930-1600:23456")[1])
bool session_just_opened = useSessionFilter and in_session and not prev_in_session

//======================================================================
// P&L EXIT TRACKING
//======================================================================
// State tracking for PROFIT/LOSS exit signals
var float pnl_entry_price = na          // Entry price for current position
var string pnl_direction = "NONE"       // "BUY" or "SELL" or "NONE"
var bool pnl_exit_fired = false         // Has PROFIT/LOSS fired for this entry?
var string pnl_exit_type = "NONE"       // Direction of the entry an exit closed

// Flatten at RTH session open. The win-rate tracker already closes any
// carried-over entry at this boundary (see SIGNAL GENERATION), so leaving
// pnl_entry_price/pnl_direction live here would let the previous session's
// entry price fire a spurious PROFIT/LOSS label + alert against the opening
// gap, and would show the dashboard a position the tracker considers closed.
if session_just_opened
    pnl_entry_price := na
    pnl_direction := "NONE"
    pnl_exit_fired := false
    pnl_exit_type := "NONE"

// Calculate current P&L for exit tracking
float current_pnl = 0.0
if pnl_direction == "BUY" and not na(pnl_entry_price)
    current_pnl := ((close - pnl_entry_price) / pnl_entry_price) * 100
else if pnl_direction == "SELL" and not na(pnl_entry_price)
    current_pnl := ((pnl_entry_price - close) / pnl_entry_price) * 100

// Target/stop hit detection
bool target_hit = current_pnl >= pnlTarget
bool stop_hit = current_pnl <= -pnlTarget

// Target/stop resolution is tracked INTERNALLY regardless of enablePnL, on a
// confirmed bar, and only once per entry. Win-rate tracking reads these — if
// they were gated on enablePnL, turning off "Enable P&L Exit Signals" (a
// display toggle) would silently make every tracked signal score as a loss
// and pin both win rates at 0%.
bool target_reached = not pnl_exit_fired and target_hit and barstate.isconfirmed
bool stop_reached   = not pnl_exit_fired and stop_hit and barstate.isconfirmed

// Visible PROFIT/LOSS exit signals (labels + alerts) — display-gated.
bool signal_profit = target_reached and enablePnL
bool signal_loss   = stop_reached and enablePnL

// When the target/stop resolves, mark as fired but DON'T reset position
// (continue tracking live P&L until the next opposite signal resets entry)
if target_reached or stop_reached
    pnl_exit_type := pnl_direction
    pnl_exit_fired := true
    // Note: pnl_direction and pnl_entry_price remain unchanged
    // Live P&L continues until reset conditions below

//======================================================================
// SUCCESS RATE TRACKING (ROLLING WINDOW)
// Every BUY/SELL signal is scored when the opposite signal closes it:
// Win if PROFIT fired at any point during the entry, Loss otherwise
// (an explicit LOSS exit, or no target hit before the reversal).
//======================================================================
// Separate tracking for BUY and SELL signals
// Uses arrays to track last N signals (configurable via maxSignalsToTrack)

var array<bool> buy_results = array.new<bool>()   // true=Win (hit PROFIT), false=Loss
var array<bool> sell_results = array.new<bool>()  // true=Win (hit PROFIT), false=Loss

// An entry's outcome isn't known until it closes (the next opposite-direction
// signal, or an RTH session-open carryover close below), so each entry's
// "won" flag accumulates PROFIT hits and is read/reset when it closes.
var bool buy_won_this_entry = false
var bool sell_won_this_entry = false
var bool buy_entry_open = false
var bool sell_entry_open = false

// Phase 4: per-module win-rate. The overall buy_results/sell_results above
// stay module-blind; these mirror them split by the module that OPENED the
// entry. *_entry_strategy is stamped with active_strategy when the entry
// opens (see UPDATE SUCCESS RATE TRACKING) and read back at every close site.
var array<ModResults> mod_results = array.new<ModResults>()
if array.size(mod_results) == 0
    array.push(mod_results, ModResults.new(array.new<bool>(), array.new<bool>()))  // 0 Trend Pullback
    array.push(mod_results, ModResults.new(array.new<bool>(), array.new<bool>()))  // 1 ORB
    array.push(mod_results, ModResults.new(array.new<bool>(), array.new<bool>()))  // 2 VWAP Fade

var string buy_entry_strategy  = "Trend Pullback"
var string sell_entry_strategy = "Trend Pullback"

strat_id(string s) => s == "ORB" ? 1 : (s == "VWAP Fade" ? 2 : 0)

// Helper function to add result to array with max limit
add_result(array<bool> arr, bool is_win, int max_size) =>
    array.push(arr, is_win)
    // Remove oldest if exceeds limit
    if array.size(arr) > max_size
        array.shift(arr)
    arr

// Push one closed-entry result into the per-module store (mutates the UDT's
// inner array in place — reference type, so no reassignment needed).
record_module(array<ModResults> store, int id, bool is_buy, bool won, int cap) =>
    ModResults mr = array.get(store, id)
    if is_buy
        array.push(mr.buys, won)
        if array.size(mr.buys) > cap
            array.shift(mr.buys)
    else
        array.push(mr.sells, won)
        if array.size(mr.sells) > cap
            array.shift(mr.sells)

// Compact "<rate>% <wins>/<total>" (or "—") for one results array — used by
// the per-module dashboard rows. Same win count as calc_win_rate.
fmt_win_rate(array<bool> arr) =>
    int t = array.size(arr)
    int w = 0
    if t > 0
        for i = 0 to t - 1
            if array.get(arr, i)
                w += 1
    t > 0 ? str.tostring((w / t) * 100, "#") + "% " + str.tostring(w) + "/" + str.tostring(t) : "—"

// Shared read-only helper — computes [wins, total, rate%] for one
// results array. Purely reads the array parameter and local variables,
// so it does not run into the "can't reassign a global" restriction.
calc_win_rate(array<bool> arr, bool enabled) =>
    int total = enabled ? array.size(arr) : 0
    int wins = 0
    if enabled and total > 0
        for i = 0 to total - 1
            if array.get(arr, i)
                wins += 1
    float rate = total > 0 ? (wins / total) * 100 : 0.0
    [wins, total, rate]

[totalWins_buy, totalTrades_buy, success_rate_buy] = calc_win_rate(buy_results, enableSuccessRate)
[totalWins_sell, totalTrades_sell, success_rate_sell] = calc_win_rate(sell_results, enableSuccessRate)

//======================================================================
// SIGNAL GENERATION (NON-REPAINTING)
//======================================================================
// b_fired/s_fired enforce strict alternation: once a BUY fires, no further
// BUY can fire — no matter how many bull/bear flips occur — until a SELL
// actually fires (and vice versa). They only clear on the opposite signal
// firing or at RTH session open; they do NOT clear on a trend direction
// change by itself. Live P&L tracking (pnl_entry_price etc.) is unaffected
// and keeps accumulating across the held direction regardless of this gate.
var bool b_fired = false
var bool s_fired = false

// in_session / session_just_opened are defined earlier (RTH SESSION WINDOW),
// ahead of P&L exit tracking so the same session-open boundary also flattens
// the carried-over position state.
//
// Reset fired flags at session open so first RTH bar fires without overnight carryover.
// An entry still open from the prior session (never closed by an opposite
// signal) would otherwise be silently dropped from win-rate tracking once
// b_fired/s_fired unblock a fresh same-direction signal — score and close
// it here first, same as a normal opposite-signal close would.
if session_just_opened
    b_fired := false
    s_fired := false
    if enableSuccessRate
        if buy_entry_open
            buy_results := add_result(buy_results, buy_won_this_entry, maxSignalsToTrack)
            record_module(mod_results, strat_id(buy_entry_strategy), true, buy_won_this_entry, maxSignalsToTrack)
            buy_entry_open := false
            buy_won_this_entry := false
        if sell_entry_open
            sell_results := add_result(sell_results, sell_won_this_entry, maxSignalsToTrack)
            record_module(mod_results, strat_id(sell_entry_strategy), false, sell_won_this_entry, maxSignalsToTrack)
            sell_entry_open := false
            sell_won_this_entry := false

// Entry freshness constraint — Score mode only (Trend mode fires directly
// off the flip bar, so it's already as fresh as possible by construction and is
// deliberately left unaffected). maxBarsFromFlip = 0 disables this.
bool entry_is_fresh = maxBarsFromFlip <= 0 or bars_since_flip <= maxBarsFromFlip

//----------------------------------------------------------------------
// STRATEGY MODULES  (regime-router refactor — Phase 2: Trend Pullback + ORB)
//----------------------------------------------------------------------
// Downstream code (P&L, win-rate, labels, alerts, dashboard) fires off
// signal_buy / signal_sell — the dispatched output of whichever strategy
// module the router selects. Each module is fully self-gated and exposes
// <name>_long / <name>_short / <name>_quality; the router only CHOOSES
// between modules, it never loosens a module's own rules. The signal
// dispatch layer below then applies session/warm-up/alternation uniformly.

// (Regime classification removed with the dashboard Strategy row — it was
// purely descriptive and had no other consumer once VWAP Fade was dropped.
// A re-added counter-trend module would recompute whatever regime test it
// needs locally; see CLAUDE.md "VWAP Fade Module".)

// --- Module: Trend Pullback -------------------------------------------------
// Raw directional trigger + quality gate for this module. sigTime
// ("Trend" / "Score") is a mode of THIS module. anchor_ready, entry_is_fresh
// and the non-repaint confirm are kept exactly where the pre-refactor
// signal lines had them: Trend mode leans on trendUp/trendDown already
// carrying barstate.isconfirmed; Score mode checks it explicitly.
bool tp_long  = false
bool tp_short = false
if sigTime == "Trend"
    tp_long  := in_session and anchor_ready and trendUp   and passes_quality_filter(final_score, minScoreBuy)
    tp_short := in_session and anchor_ready and trendDown and passes_quality_filter(final_score, minScoreSell)
else  // "Score"
    tp_long  := in_session and anchor_ready and entry_is_fresh and barstate.isconfirmed and is_bull and
       passes_quality_filter(final_score, minScoreBuy)
    tp_short := in_session and anchor_ready and entry_is_fresh and barstate.isconfirmed and is_bear and
       passes_quality_filter(final_score, minScoreSell)
int tp_quality = final_score

// --- Module: Opening Range Breakout ---------------------------------------
// Range = high/low of the first orbMinutes of the RTH session, latched once
// the window closes. Then the first confirmed close that clears a range edge
// (by orbBufferATR x ATR-14), within orbEntryCutoffMin of the open, with
// enough volume / VWAP alignment / setup quality, fires ONE breakout per
// session. Anchored to session_just_opened, so it needs useSessionFilter ON;
// with the filter off orb_open_time stays na, the range never locks, and the
// module is inert. Non-repainting: the range only latches on a confirmed bar
// and every breakout term requires barstate.isconfirmed.
var int   orb_open_time = na    // epoch ms of the RTH open bar (session anchor)
var float orb_high      = na
var float orb_low       = na
var bool  orb_locked    = false
var bool  orb_done      = false // breakout already taken this session

if session_just_opened
    orb_open_time := time
    orb_high := high
    orb_low  := low
    orb_locked := false
    orb_done := false

float orb_mins = not na(orb_open_time) ? (time - orb_open_time) / 60000.0 : na

// Extend the range through the first orbMinutes, then latch it (confirmed bars
// only — matches the non-repaint guarantee the anchors carry).
if barstate.isconfirmed and orbEnabled and in_session and not na(orb_mins) and not orb_locked
    if orb_mins < orbMinutes
        orb_high := math.max(orb_high, high)
        orb_low  := math.min(orb_low, low)
    else
        orb_locked := true

// Breakout evaluation
float orb_buf = orbBufferATR * atr
bool orb_long_setup  = orb_locked and not na(orb_high) and close > orb_high + orb_buf
bool orb_short_setup = orb_locked and not na(orb_low)  and close < orb_low  - orb_buf
int  orb_dir = orb_long_setup ? 1 : orb_short_setup ? -1 : 0

// Setup quality (0-100): range geometry + breakout volume + alignment + fuel
float orb_range_atr = orb_locked and not na(orb_high) and not na(orb_low) and atr > 0 ? (orb_high - orb_low) / atr : na
int orb_q = 0
if not na(orb_range_atr)
    orb_q := orb_range_atr >= 0.75 and orb_range_atr <= 2.0 ? 30 : (orb_range_atr >= 0.5 and orb_range_atr <= 3.0 ? 18 : 8)
orb_q += (rel_vol >= 2.0 ? 30 : (rel_vol >= 1.5 ? 22 : (rel_vol >= 1.2 ? 14 : (rel_vol >= 1.0 ? 6 : 0))))
orb_q += (((orb_dir == 1 and not na(vwap) and close > vwap) or (orb_dir == -1 and not na(vwap) and close < vwap)) ? 12 : 0)
orb_q += (((orb_dir == 1 and is_bull) or (orb_dir == -1 and is_bear)) ? 8 : 0)
orb_q += (fuel_used < 50 ? 20 : (fuel_used < 75 ? 12 : (fuel_used < fuel_max ? 5 : 0)))
int orb_quality = math.min(orb_q, 100)

bool orb_vol_ok        = orbMinRvol <= 0 or rel_vol >= orbMinRvol
bool orb_vwap_long_ok  = not orbRequireVwapSide or (not na(vwap) and close > vwap)
bool orb_vwap_short_ok = not orbRequireVwapSide or (not na(vwap) and close < vwap)
bool orb_cutoff_ok     = orbEntryCutoffMin <= 0 or (not na(orb_mins) and orb_mins <= orbEntryCutoffMin)

bool orb_long  = orbEnabled and in_session and barstate.isconfirmed and not orb_done and orb_cutoff_ok and
   orb_long_setup and orb_vol_ok and orb_vwap_long_ok and orb_quality >= orbMinQuality
bool orb_short = orbEnabled and in_session and barstate.isconfirmed and not orb_done and orb_cutoff_ok and
   orb_short_setup and orb_vol_ok and orb_vwap_short_ok and orb_quality >= orbMinQuality

if orb_long or orb_short
    orb_done := true

// --- Regime router -------------------------------------------------------
// Priority (last write wins): Trend Pullback (default) < ORB.
// (The VWAP Fade counter-trend module from the parent project is removed in
// the light build; ORB is retired-but-inert, orbEnabled = false.)
string active_strategy = "Trend Pullback"
int    strat_quality   = tp_quality
bool   strat_long      = tp_long
bool   strat_short     = tp_short

if orb_long or orb_short
    active_strategy := "ORB"
    strat_quality   := orb_quality
    strat_long      := orb_long
    strat_short     := orb_short

// --- Setup quality rating (of the active strategy) ----------------------
// stars drives the BUY/SELL chart labels. Reads strat_quality (the active
// module's 0-100 quality) rather than final_score directly: Trend Pullback
// -> final_score, ORB -> orb_quality (inert in the light build).
int active_threshold = is_bull ? minScoreBuy : minScoreSell
string stars = strat_quality >= active_threshold + 30 ? "⭐⭐⭐" :
   strat_quality >= active_threshold + 15 ? "⭐⭐" :
   strat_quality >= active_threshold ? "⭐" : "⚠️"

//----------------------------------------------------------------------
// SIGNAL DISPATCH — strict BUY/SELL alternation (NON-REPAINTING)
//----------------------------------------------------------------------
// b_fired/s_fired block a same-direction repeat — no matter how many
// regime/trend flips occur — until the opposite side actually fires.
// Applies to whatever module the router selected. Cleared here and at
// RTH session open. Live P&L tracking does not consult these flags.
bool signal_buy  = strat_long  and not b_fired
bool signal_sell = strat_short and not s_fired

if signal_buy
    b_fired := true
    s_fired := false  // Reset opposite to allow next SELL
if signal_sell
    s_fired := true
    b_fired := false  // Reset opposite to allow next BUY


//======================================================================
// CALCULATE SIGNAL P&L (BETWEEN ANY CONSECUTIVE SIGNALS)
//======================================================================
// This remains independent - always shows incremental P&L between signals
float signal_pnl = na

if showSignalPnL and has_previous_signal and not na(last_signal_price)
    if last_signal_type == "BUY"
        signal_pnl := ((close - last_signal_price) / last_signal_price) * 100
    else if last_signal_type == "SELL"
        signal_pnl := ((last_signal_price - close) / last_signal_price) * 100

//======================================================================
// UPDATE SUCCESS RATE TRACKING (ROLLING WINDOW)
//======================================================================
// add_result() and the buy/sell won/open state are declared earlier
// (alongside buy_results/sell_results) so the RTH session-open reset can
// also close out a carried-over entry before this section runs.

// Reads target_reached (not signal_profit) so win-rate stays correct when the
// PROFIT/LOSS display toggle (enablePnL) is off.
if enableSuccessRate
    if target_reached and pnl_direction == "BUY"
        buy_won_this_entry := true
    if target_reached and pnl_direction == "SELL"
        sell_won_this_entry := true

    // The opposite signal closes the prior entry — score it now, into both
    // the overall array and the per-module store (keyed by the module that
    // opened it).
    if signal_sell and buy_entry_open
        buy_results := add_result(buy_results, buy_won_this_entry, maxSignalsToTrack)
        record_module(mod_results, strat_id(buy_entry_strategy), true, buy_won_this_entry, maxSignalsToTrack)
    if signal_buy and sell_entry_open
        sell_results := add_result(sell_results, sell_won_this_entry, maxSignalsToTrack)
        record_module(mod_results, strat_id(sell_entry_strategy), false, sell_won_this_entry, maxSignalsToTrack)

    // Open the new entry — stamp it with the module the router picked this bar.
    if signal_buy
        buy_entry_open := true
        buy_won_this_entry := false
        buy_entry_strategy := active_strategy
    if signal_sell
        sell_entry_open := true
        sell_won_this_entry := false
        sell_entry_strategy := active_strategy

//======================================================================
// UPDATE SIGNAL P&L TRACKING (INDEPENDENT SYSTEM)
//======================================================================
if signal_buy
    last_signal_price := close
    last_signal_type := "BUY"
    has_previous_signal := true

if signal_sell
    last_signal_price := close
    last_signal_type := "SELL"
    has_previous_signal := true

//======================================================================
// UPDATE P&L EXIT TRACKING
//======================================================================
// Pine functions cannot reassign a value-type (float/int/bool/string)
// global variable, even one declared with `var` — only reference types
// (array/matrix/map/UDT) can be mutated from inside a function via a
// parameter. pnl_entry_price/pnl_direction/etc. are plain value types,
// so the entry/re-arm logic stays inlined at each branch below.

// Reset entry on every new signal. b_fired/s_fired strict alternation
// (see SIGNAL GENERATION above) means signal_buy can only fire while
// pnl_direction is "SELL" or "NONE" — never while still "BUY" — except
// for the rare case where pnl_direction survived an RTH session reset
// from the prior session's still-open position.
if signal_buy
    pnl_entry_price := close
    pnl_direction := "BUY"
    pnl_exit_fired := false

if signal_sell
    pnl_entry_price := close
    pnl_direction := "SELL"
    pnl_exit_fired := false

//======================================================================
// LIVE P&L TRACKING (DASHBOARD DISPLAY)
//======================================================================
// Dashboard P&L uses the same entry price as PROFIT/LOSS tracking
// This ensures consistency between dashboard display and exit signals
float live_pnl_pct = 0.0

if pnl_direction == "BUY" and not na(pnl_entry_price)
    live_pnl_pct := ((close - pnl_entry_price) / pnl_entry_price) * 100
else if pnl_direction == "SELL" and not na(pnl_entry_price)
    live_pnl_pct := ((pnl_entry_price - close) / pnl_entry_price) * 100
else
    live_pnl_pct := 0.0

string pnl_text = pnl_direction != "NONE" ?
                  str.format("{0,number,+#.##;-#.##}%", live_pnl_pct) :
                  "—"

//======================================================================
// DYNAMIC ANCHOR-AWARE VISUAL ELEMENTS
//======================================================================

//----------------------------------------------------------------------
// CONDITIONAL DISPLAY: Show active anchor only
//----------------------------------------------------------------------

// EMA9 Continuous Line (only when EMA Cross mode active)
// Single line that changes color based on trend direction
// No gaps - plots on every bar
color ema9_color = is_bull ? color.green : color.red
plot(anchorMode == "EMA Cross" ? ema9 : na, "EMA9 Dynamic", 
     color = ema9_color, style = plot.style_line, linewidth = 3)

// EMA Cross Flip Circles (only in EMA Cross mode)
plotshape(anchorMode == "EMA Cross" and showCircles and trendUp ? ema9 : na,
     title = "EMA Cross Up",
     location = location.absolute,
     style = shape.circle,
     size = size.tiny,
     color = color.green)

plotshape(anchorMode == "EMA Cross" and showCircles and trendDown ? ema9 : na,
     title = "EMA Cross Down",
     location = location.absolute,
     style = shape.circle,
     size = size.tiny,
     color = color.red)

// SMA Anchor Line (only when SMA mode active)
// Colored by the latched state, with the ATR buffer band drawn either side so
// the neutral zone that suppresses whipsaw flips is visible on the chart.
color sma_color = is_bull ? color.green : color.red
plot(anchorMode == "SMA" ? smaAnchor : na, "SMA Anchor",
     color = sma_color, style = plot.style_line, linewidth = 3)

smaUpper = plot(anchorMode == "SMA" and smaBufferATR > 0 ? smaAnchor + sma_band : na,
     "SMA Buffer Upper", color = color.new(color.gray, 60), style = plot.style_line, linewidth = 1)
smaLower = plot(anchorMode == "SMA" and smaBufferATR > 0 ? smaAnchor - sma_band : na,
     "SMA Buffer Lower", color = color.new(color.gray, 60), style = plot.style_line, linewidth = 1)

fill(smaUpper, smaLower,
     color = showBg and anchorMode == "SMA" ? color.new(color.gray, 90) : color.new(color.white, 100))

// SMA Flip Circles (only in SMA mode)
plotshape(anchorMode == "SMA" and showCircles and trendUp ? smaAnchor : na,
     title = "SMA Bullish Flip",
     location = location.absolute,
     style = shape.circle,
     size = size.tiny,
     color = color.green)

plotshape(anchorMode == "SMA" and showCircles and trendDown ? smaAnchor : na,
     title = "SMA Bearish Flip",
     location = location.absolute,
     style = shape.circle,
     size = size.tiny,
     color = color.red)

// Opening Range levels (locked high/low for the current session; break
// between sessions via style_linebr so lines don't connect across the gap)
plot(orbShowLevels and orb_locked and in_session ? orb_high : na, "ORB High",
     color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 1)
plot(orbShowLevels and orb_locked and in_session ? orb_low : na, "ORB Low",
     color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 1)

//======================================================================
// BUY/SELL LABELS WITH ANCHOR-AWARE POSITIONING
//======================================================================
if signal_buy and showLabels
    string label_text = "BUY " + stars + (active_strategy == "ORB" ? " ⚡ORB" : "")

    if showSignalPnL and not na(signal_pnl)
        label_text += "\n" + str.tostring(signal_pnl, "+#.##;-#.##") + "%"
    
    // Anchor-aware label position (see anchor_line_price definition)
    float label_price = anchor_line_price
    
    label.new(bar_index, label_price, label_text,
         yloc = yloc.price,
         style = label.style_label_up,
         color = color.green,
         textcolor = color.white,
         size = size.normal)

if signal_sell and showLabels
    string label_text = "SELL " + stars + (active_strategy == "ORB" ? " ⚡ORB" : "")

    if showSignalPnL and not na(signal_pnl)
        label_text += "\n" + str.tostring(signal_pnl, "+#.##;-#.##") + "%"
    
    // Anchor-aware label position (see anchor_line_price definition)
    float label_price = anchor_line_price
    
    label.new(bar_index, label_price, label_text,
         yloc = yloc.price,
         style = label.style_label_down,
         color = color.red,
         textcolor = color.white,
         size = size.normal)

//======================================================================
// PROFIT/LOSS EXIT LABELS WITH ANCHOR-AWARE POSITIONING
//======================================================================
if signal_profit and enablePnL
    string label_text = "PROFIT +" + str.tostring(pnlTarget, "#.#") + "%"
    // Anchor-aware label position (see anchor_line_price definition)
    float label_price = anchor_line_price
    string label_style = label.style_label_up

    if signal_buy
        label_style := label.style_label_down
    else if signal_sell
        label_style := label.style_label_up
    else
        if pnl_exit_type == "BUY"
            label_style := label.style_label_up
        else if pnl_exit_type == "SELL"
            label_style := label.style_label_down

    label.new(bar_index, label_price, label_text,
         yloc = yloc.price,
         style = label_style,
         color = color.new(color.blue, 0),
         textcolor = color.white,
         size = size.normal)

if signal_loss and enablePnL
    string label_text = "LOSS -" + str.tostring(pnlTarget, "#.#") + "%"
    // Anchor-aware label position (see anchor_line_price definition)
    float label_price = anchor_line_price
    string label_style = label.style_label_down

    if signal_buy
        label_style := label.style_label_down
    else if signal_sell
        label_style := label.style_label_up
    else
        if pnl_exit_type == "BUY"
            label_style := label.style_label_down
        else if pnl_exit_type == "SELL"
            label_style := label.style_label_up

    label.new(bar_index, label_price, label_text,
         yloc = yloc.price,
         style = label_style,
         color = color.new(color.blue, 0),
         textcolor = color.white,
         size = size.normal)

//======================================================================
// DASHBOARD
//======================================================================
if showDash and barstate.islast
    // Dashboard score = the active strategy's quality (Phase 1: Trend
    // Pullback, so strat_quality == final_score).
    int dashboard_score = strat_quality

    // Use trend-appropriate threshold for dashboard display
    int dashboard_threshold = is_bull ? minScoreBuy : minScoreSell

    string dashboard_quality = dashboard_score >= dashboard_threshold + 30 ? "⭐⭐⭐ EXCELLENT" : 
                               dashboard_score >= dashboard_threshold + 15 ? "⭐⭐ STRONG" : 
                               dashboard_score >= dashboard_threshold ? "⭐ GOOD" : "⚠️ WEAK"
    
    // Fixed row allocation to prevent overflow
    
    // Count active gates
    int active_gate_count = 0
    if gate1_squeeze
        active_gate_count += 1
    if gate2_stretched
        active_gate_count += 1
    if gate3_fuel
        active_gate_count += 1
    if gate4_liquidity
        active_gate_count += 1

    var table d = table.new(position.bottom_right, 2, DASHBOARD_MAX_ROWS,
         bgcolor = color.new(color.black, 0), border_width = 1)

    // The table is `var`, so cells persist across renders. The gate-details
    // block is variable-length: when a gate deactivates, its rows would keep
    // displaying last render's (now false) warning. Wipe every row first.
    table.clear(d, 0, 0, 1, DASHBOARD_MAX_ROWS - 1)

    // Header
    string header_with_pnl = "SLT " + VERSION + " | PnL " + pnl_text
    string fixed_header = header_with_pnl + str.substring(DASH_WIDTH, 0, math.max(0, 40 - str.length(header_with_pnl)))

    table.cell(d, 0, 0, fixed_header, 
        text_color = color.white, 
        bgcolor = color.new(color.gray, 40),
        text_size = size.small,
        text_halign = text.align_center)
    table.merge_cells(d, 0, 0, 1, 0)
    
    int row = 1

    // Trend — reports the ACTIVE anchor (EMA9 or SMA) and its own line price.
    // anchor_ready is false only while an SMA anchor is still warming up (chart
    // has fewer bars than smaLenActive). Without this branch the row would read
    // "BULLISH 🔼 @ NaN" off the latch's initial value and the na SMA price.
    string trend_state = not anchor_ready ? "WARMING UP ⏳" : is_bull ? "BULLISH 🔼" : "BEARISH 🔽"
    color trend_color = not anchor_ready ? color.gray : is_bull ? color.lime : color.orange
    string trend_cell = not anchor_ready ?
         trend_state + " (" + str.tostring(smaLenActive) + " bars)" :
         trend_state + " @ " + str.tostring(anchor_line_price, format.mintick)
    table.cell(d, 0, row, "Trend (" + anchor_short + ")", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, trend_cell, text_color = trend_color, text_size = size.small)
    row += 1
    
    // Profile Name
    table.cell(d, 0, row, "Profile", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, profile_name, text_color = color.white, text_size = size.small)
    row += 1
    
    // Signal Anchor Display with dynamic EMA period
    string anchor_display = ""
    if anchorMode == "SMA"
        anchor_display := "SMA (" + str.tostring(smaLenActive) + ") auto ±" + str.tostring(smaBufferATR, "#.##") + "A"
    else  // EMA Cross
        anchor_display := "EMA Cross (9/" + str.tostring(emaSlowPeriod) + ") auto"
    
    table.cell(d, 0, row, "Signal Anchor", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, anchor_display, text_color = color.white, text_size = size.small)
    row += 1

    // ORB module status (optional row — only when the module is enabled)
    if orbEnabled
        string orb_dash = not useSessionFilter ? "⚠️ needs RTH filter" :
                          na(orb_open_time) ? "waiting for open" :
                          not orb_locked ? "forming " + str.tostring(orb_high, format.mintick) + " / " + str.tostring(orb_low, format.mintick) :
                          orb_done ? "✅ fired this session" :
                          "armed " + str.tostring(orb_high, format.mintick) + " / " + str.tostring(orb_low, format.mintick) + "  Q" + str.tostring(orb_quality)
        table.cell(d, 0, row, "ORB", text_color = color.white, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, orb_dash, text_color = color.gray, text_size = size.small)
        row += 1

    // ATR Fuel
    string fuel_status = ""
    
    // Simplified fuel status (removed early session detection)
    if fuel_used > fuel_max
        if is_high_velocity
            fuel_status := "🔥 VELOCITY OVERRIDE (" + str.tostring(fuel_used, "#") + "%)"
        else
            fuel_status := "🔴 EXHAUSTED (" + str.tostring(fuel_used, "#") + "%)"
    else if fuel_used > 75
        fuel_status := "⚠️ HIGH (" + str.tostring(fuel_used, "#") + "%)"
    else if fuel_used > 50
        fuel_status := "📊 MODERATE (" + str.tostring(fuel_used, "#") + "%)"
    else if fuel_used > 25
        fuel_status := "✅ FRESH (" + str.tostring(fuel_used, "#") + "%)"
    else
        fuel_status := "💪 FULL FUEL (" + str.tostring(fuel_used, "#") + "%)"
    
    table.cell(d, 0, row, "ATR Fuel", 
         text_color = color.white, 
         text_halign = text.align_left, 
         text_size = size.small)
    table.cell(d, 1, row, fuel_status, 
         text_color = color.white,
         text_size = size.small)
    row += 1
    
    // Setup Score
    table.cell(d, 0, row, "Setup Score", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, dashboard_quality + " (" + str.tostring(dashboard_score) + ")", text_color = color.white, text_size = size.small)
    row += 1
    
    // Gates Display
    string gate_label = gateOn ? "Gates" : "Risks"
    string count_display = active_gate_count > 0 ? str.tostring(active_gate_count) + " ACTIVE" : "NO ACTIVE"
    color gate_color = active_gate_count > 0 ? color.orange : color.new(color.gray, 40)

    table.cell(d, 0, row, gate_label, text_color = gate_color, text_halign = text.align_left, text_size = size.small)
    table.cell(d, 1, row, count_display, text_color = gate_color, text_size = size.small)
    row += 1
    
    // SUCCESS RATE DISPLAY (BETWEEN GATES AND EXTENDED METRICS)
    // Win rate of PROFIT/LOSS target exits, BUY and SELL tracked separately.
    if enableSuccessRate
        // Separator before success rates
        table.cell(d, 0, row, "─────────────────────", text_color = color.new(color.gray, 60), text_size = size.small)
        table.merge_cells(d, 0, row, 1, row)
        row += 1

        // BUY Win Rate
        string buy_count_text = totalTrades_buy >= maxSignalsToTrack ?
                                 str.tostring(totalWins_buy) + "/" + str.tostring(totalTrades_buy) + " (max)" :
                                 str.tostring(totalWins_buy) + "/" + str.tostring(totalTrades_buy)

        string buy_rate_display = totalTrades_buy > 0 ?
                                  str.tostring(success_rate_buy, "#.#") + "% [" + buy_count_text + "]" :
                                  "— [0/0]"

        color buy_rate_color = success_rate_buy >= 60 ? color.lime :
                               success_rate_buy >= 50 ? color.yellow : color.red

        table.cell(d, 0, row, "BUY Win Rate",
             text_color = color.white,
             text_halign = text.align_left,
             text_size = size.small)
        table.cell(d, 1, row, buy_rate_display,
             text_color = buy_rate_color,
             text_size = size.small)
        row += 1

        // SELL Win Rate
        string sell_count_text = totalTrades_sell >= maxSignalsToTrack ?
                                 str.tostring(totalWins_sell) + "/" + str.tostring(totalTrades_sell) + " (max)" :
                                 str.tostring(totalWins_sell) + "/" + str.tostring(totalTrades_sell)

        string sell_rate_display = totalTrades_sell > 0 ?
                                   str.tostring(success_rate_sell, "#.#") + "% [" + sell_count_text + "]" :
                                   "— [0/0]"

        color sell_rate_color = success_rate_sell >= 60 ? color.lime :
                                 success_rate_sell >= 50 ? color.yellow : color.red

        table.cell(d, 0, row, "SELL Win Rate",
             text_color = color.white,
             text_halign = text.align_left,
             text_size = size.small)
        table.cell(d, 1, row, sell_rate_display,
             text_color = sell_rate_color,
             text_size = size.small)
        row += 1

        // Per-module win rate (Phase 4). Only drawn in a MULTI-MODULE build:
        // with just Trend Pullback live, mod_results[0] restates the BUY/SELL
        // Win Rate rows above it, so the rows are suppressed. The mod_results /
        // record_module plumbing keeps running regardless, so the rows return
        // intact the moment a second module goes live. Rows are styled to match
        // the BUY / SELL Win Rate rows — white label, value colour-coded by the
        // module's combined BUY+SELL rate.
        bool multi_module = orbEnabled   // extend when another module is re-added
        for mi = 0 to 2
            bool mi_show = multi_module and (mi == 0 or (mi == 1 and orbEnabled))
            if mi_show and row < DASHBOARD_MAX_ROWS
                ModResults mr = array.get(mod_results, mi)
                string mname = mi == 1 ? "ORB" : mi == 2 ? "VWAP Fade" : "Trend Pull"
                [mw_b, mt_b, _mr_b] = calc_win_rate(mr.buys, true)
                [mw_s, mt_s, _mr_s] = calc_win_rate(mr.sells, true)
                int   mt_all = mt_b + mt_s
                float mrate_all = mt_all > 0 ? (mw_b + mw_s) / mt_all * 100 : 0.0
                color m_rate_color = mt_all == 0 ? color.new(color.gray, 40) : mrate_all >= 60 ? color.lime : mrate_all >= 50 ? color.yellow : color.red
                string mtxt = "B " + fmt_win_rate(mr.buys) + "   S " + fmt_win_rate(mr.sells)
                table.cell(d, 0, row, mname, text_color = color.white, text_halign = text.align_left, text_size = size.small)
                table.cell(d, 1, row, mtxt, text_color = m_rate_color, text_size = size.small)
                row += 1

    // Extended Metrics
    if extDash
        // Separator
        table.cell(d, 0, row, "─────────────────────", text_color = color.new(color.gray, 60), text_size = size.small)
        table.merge_cells(d, 0, row, 1, row)
        row += 1
        
        // Component Breakdown
        table.cell(d, 0, row, "EMA Cascade", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, t_status + " (" + str.tostring(t_pts) + ")", text_color = color.white, text_size = size.small)
        row += 1
        
        table.cell(d, 0, row, "VWAP Value", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, v_status + " (" + str.tostring(v_pts) + ")", text_color = color.white, text_size = size.small)
        row += 1
        
        table.cell(d, 0, row, "Volume", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, vol_status + " (" + str.tostring(vol_pts) + ")", text_color = color.white, text_size = size.small)
        row += 1
        
        table.cell(d, 0, row, "ADX Strength", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, a_status + " (" + str.tostring(a_pts) + ")", text_color = color.white, text_size = size.small)
        row += 1
        
        table.cell(d, 0, row, "Momentum", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(d, 1, row, r_status + " (" + str.tostring(r_pts) + ")", text_color = color.white, text_size = size.small)
        row += 1

        // ATR Info
        string atr_info = "ATR(14): $" + str.tostring(atr_14, "#.##") + 
                         " | Range: $" + str.tostring(session_range, "#.##")
        
        table.cell(d, 0, row, "Volatility", 
             text_color = color.gray, 
             text_halign = text.align_left, 
             text_size = size.small)
        table.cell(d, 1, row, atr_info,
             text_color = color.white,
             text_size = size.small)
        row += 1

        // Bars From Flip — lets the user calibrate maxBarsFromFlip from observation
        string bars_flip_display = str.tostring(bars_since_flip) +
             (maxBarsFromFlip > 0 ? " / " + str.tostring(maxBarsFromFlip) + " max" : " (unlimited)")
        color bars_flip_color = maxBarsFromFlip > 0 and bars_since_flip > maxBarsFromFlip ? color.gray : color.white

        table.cell(d, 0, row, "Bars From Flip",
             text_color = color.gray,
             text_halign = text.align_left,
             text_size = size.small)
        table.cell(d, 1, row, bars_flip_display,
             text_color = bars_flip_color,
             text_size = size.small)
        row += 1

        // Gate Details
        if gate_message != ""
            array<string> gate_lines = array.new<string>()
            string current_line = ""
            string gate_detail_label = gateOn ? "Gate Details" : "Risk Details"
            
            array<string> words = str.split(gate_message, " ")
            
            for i = 0 to array.size(words) - 1
                string word = array.get(words, i)
                string test_line = current_line == "" ? word : current_line + " " + word
                
                if str.length(test_line) <= 30
                    current_line := test_line
                else
                    if current_line != ""
                        array.push(gate_lines, current_line)
                    current_line := word
            
            if current_line != ""
                array.push(gate_lines, current_line)
            
            for i = 0 to array.size(gate_lines) - 1
                if row >= DASHBOARD_MAX_ROWS
                    break
                string line_text = array.get(gate_lines, i)

                if i == 0
                    table.cell(d, 0, row, gate_detail_label,
                         text_color = color.orange,
                         text_halign = text.align_left,
                         text_size = size.small)
                    table.cell(d, 1, row, line_text,
                         text_color = color.orange,
                         text_size = size.small)
                else
                    table.cell(d, 0, row, "",
                         text_color = color.orange,
                         text_size = size.small)
                    table.cell(d, 1, row, line_text,
                         text_color = color.orange,
                         text_size = size.small)

                row += 1

//======================================================================
// ALERTS
//======================================================================
alertcondition(signal_buy, title = "BUY", message = "BUY")
alertcondition(signal_sell, title = "SELL", message = "SELL")
alertcondition(signal_profit, title = "PROFIT", message = "PROFIT")
alertcondition(signal_loss, title = "LOSS", message = "LOSS")